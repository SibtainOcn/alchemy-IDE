<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!--
      The Alchemy A.

      Two legs and a raised crossbar, stroked rather than filled, so it holds its weight
      at 24dp on a bar and at 108dp on a launcher without a second drawing. The crossbar
      sits above the optical centre, which is what keeps the counter a triangle: the
      alchemical sign for fire, and the reason the letter was chosen as the mark.
    -->
    <path
        android:pathData="M4.6,20 L12,4 L19.4,20"
        android:fillColor="#00000000"
        android:strokeWidth="2"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M8.15,12.3 L15.85,12.3"
        android:fillColor="#00000000"
        android:strokeWidth="2"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />
</vector>
