<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">
    <!--
      The same A as the launcher, on the starting window. Kept identical on purpose: the
      system splash hands straight over to the app's own splash, and a mark that changed
      shape across that handover would read as a flicker.
    -->
    <path
        android:pathData="M38,84 L60,36 L82,84"
        android:fillColor="#00000000"
        android:strokeWidth="7"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M47.5,68 L72.5,68"
        android:fillColor="#00000000"
        android:strokeWidth="7"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />
</vector>
