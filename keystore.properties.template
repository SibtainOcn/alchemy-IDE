# Release signing — local template.
#
# Copy this file to `keystore.properties` in the repo root and fill it in. The real file
# is gitignored and must never be committed.
#
#     cp keystore.properties.template keystore.properties
#
# Once it exists, `./gradlew assembleRelease` and Android Studio's Run button on the
# release variant both produce a signed, installable APK. Without it the release build
# still succeeds and simply produces an unsigned APK.
#
# CI does not use this file. It reads the same four values from the environment:
# ALCHEMY_STORE_FILE, ALCHEMY_STORE_PASSWORD, ALCHEMY_KEY_ALIAS, ALCHEMY_KEY_PASSWORD.
# The old HAZEL_ prefixed names are still read as a fallback.

# Absolute path to the keystore. On Windows use forward slashes or escaped backslashes.
storeFile=C:/S-DRIVE/HAZEL-CODE-KEY/hazel-code-release

# Password for the keystore file itself.
storePassword=

# The key inside the keystore, and its password.
keyAlias=
keyPassword=
